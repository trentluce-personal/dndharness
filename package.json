{
  "name": "dndharness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@dndharness/web --",
    "build": "npm run build --workspaces --if-present",
    "test:web": "npm run test --workspace=@dndharness/web",
    "preview": "npm run preview --workspace=@dndharness/web --",
    "browser": "playwright-cli"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22"
  }
}
