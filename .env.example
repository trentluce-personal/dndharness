# Copy to .env and use a long, URL-safe password (letters/numbers or hex).
# Existing PostgreSQL volumes retain their original password.
POSTGRES_PASSWORD=replace-with-your-own-long-random-password

# Local-only by default. See README.md for explicit LAN opt-in and firewall setup.
WEB_BIND_ADDRESS=127.0.0.1
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# LAN example: replace 192.168.1.50 with this computer's actual LAN address.
# WEB_BIND_ADDRESS=0.0.0.0
# APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://192.168.1.50:5173
